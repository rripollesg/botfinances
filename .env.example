# Copia este archivo a .env y rellena los valores.
# NUNCA subas .env a GitHub.

TELEGRAM_TOKEN=tu_token_de_botfather
CHAT_ID=tu_chat_id_numerico
GROQ_API_KEY=

# yfinance = standalone (recomendado para GitHub Actions)
FUENTE_DATOS=yfinance

# Parámetros del backtest
BACKTEST_INITIAL_CAPITAL=10000
BACKTEST_COMMISSION_PCT=0.001
BACKTEST_SPREAD_PCT=0.0005
BACKTEST_STOP_LOSS_PCT=0.08
BACKTEST_TAKE_PROFIT_PCT=0.15
BACKTEST_OUTPUT_DIR=backtests

# Comandos útiles:
# Escaneo normal:
#   python bot.py
#
# Prueba de Telegram:
#   python bot.py test-telegram
#
# Backtest:
#   python bot.py backtest
#
# Si usas entorno virtual:
#   source .venv/bin/activate
#   python bot.py
#   python bot.py test-telegram
#   python bot.py backtest
